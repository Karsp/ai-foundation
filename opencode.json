{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask",
      "opencode.json": "ask",
      ".mcp.json": "ask",
      ".claude/*": "ask",
      ".github/workflows/*": "ask",
      ".devcontainer/*": "ask"
    },
    "shell": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm install*": "ask",
      "npm i *": "ask",
      "npx *": "ask",
      "pip install*": "ask",
      "uv add *": "ask",
      "uvx *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git commit*--no-verify*": "deny",
      "git commit -n*": "deny",
      "git push*--no-verify*": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny",
      "*| sh*": "deny",
      "*| bash*": "deny",
      "*.env*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.gnupg/**": "deny"
    },
    "webfetch": "ask",
    "doom_loop": "ask"
  },
  "mcp": {}
}
