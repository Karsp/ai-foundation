{
  // Dev container for agents (ADR-0004). Guide: docs/development/environment.md
  "name": "ai-foundation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    // Which agents to install (empty = none) and which firewall lists to turn
    // on besides "base". Versions at least 72 hours old. Lists: .devcontainer/firewall/
    // Example for OpenCode with OpenAI: "OPENCODE_VERSION": "1.19.4",
    // "FIREWALL_LISTS": "anthropic opencode openai"
    "args": {
      "CLAUDE_CODE_VERSION": "2.1.304",
      "OPENCODE_VERSION": "",
      "FIREWALL_LISTS": "anthropic"
    }
  },
  // The firewall needs these two capabilities; nothing else is added.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "ubuntu",
  // Only the project folder is shared with the host: no home folder, no ~/.ssh,
  // no cloud credentials, no Docker socket.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
